# CryptoIdea — Cloud Functions environment variables
# =====================================================
# functions.config() was removed in firebase-functions v7, so config now comes
# from (1) the locked config/app Firestore doc set via the Admin dashboard
# (PRIMARY for the PayPal client/secret/webhook + CoinGecko key), and (2) these
# env vars (FALLBACK, and the ONLY source for the PayPal plan IDs + APP_URL).
#
# Copy this file to `functions/.env` (git-ignored) and fill in real values, or
# set them in your deploy environment. NEVER commit the real .env.

# PayPal. client/secret/webhook can instead be set in Admin → Settings.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# H6: four plan IDs — pro/premium × monthly/yearly. A yearly buyer is charged the
# yearly plan (a single-id-per-tier setup mischarged them the monthly price).
PAYPAL_PRO_MONTHLY_PLAN_ID=P-XXXXXXXXXXXXXXXX
PAYPAL_PRO_YEARLY_PLAN_ID=P-XXXXXXXXXXXXXXXX
PAYPAL_PREMIUM_MONTHLY_PLAN_ID=P-XXXXXXXXXXXXXXXX
PAYPAL_PREMIUM_YEARLY_PLAN_ID=P-XXXXXXXXXXXXXXXX
# Legacy single-id-per-tier names (still read as the MONTHLY fallback for back-compat).
# PAYPAL_PLAN_ID=
# PAYPAL_PREMIUM_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# G7: which PayPal environment to talk to — "sandbox" (test end-to-end with a sandbox
# buyer account, no real charge) or "live" (default). Sandbox is strictly opt-in.
PAYPAL_ENV=live

# Public app URL used for PayPal redirect return/cancel links.
APP_URL=https://crypto-idea.web.app

# CoinGecko Demo/paid API key — can instead be set in Admin → Settings.
# Required for the "all ~3,000 coins every 5 min" price refresh at scale.
COINGECKO_DEMO_KEY=
# AI provider (Wave-B research proxy). PRIMARY config is Admin → Settings → AI
# (config/app.ai): the API key, the generation + judge model ids, and the base URL are
# pasted there so the provider/model is swappable with no code change. These env vars are
# an optional FALLBACK for the key/endpoint. No provider name is hardcoded anywhere.
AI_PROVIDER_KEY=
AI_PROVIDER_BASE=
# The default provider's required request version header value + name (override for another
# provider). Leave unset to use the built-in defaults.
AI_API_VERSION=
AI_API_VERSION_HEADER=
# Email is SMTP-only (provider-agnostic) — configure host/port/user/pass/from in
# Admin → Settings → Email. No email-provider name is hardcoded; any SMTP provider works.
