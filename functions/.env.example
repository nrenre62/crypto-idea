# Crypto Idea — Cloud Functions environment variables
# =====================================================
# functions.config() was removed in firebase-functions v7, so config now comes
# from (1) the locked config/app Firestore doc set via the Admin dashboard
# (PRIMARY for the PayPal client/secret/webhook + CoinGecko key), and (2) these
# env vars (FALLBACK, and the ONLY source for the PayPal plan IDs + APP_URL).
#
# Copy this file to `functions/.env` (git-ignored) and fill in real values, or
# set them in your deploy environment. NEVER commit the real .env.

# PayPal (live). client/secret/webhook can instead be set in Admin → Settings.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=P-XXXXXXXXXXXXXXXX
PAYPAL_PREMIUM_PLAN_ID=P-XXXXXXXXXXXXXXXX
PAYPAL_WEBHOOK_ID=

# Public app URL used for PayPal redirect return/cancel links.
APP_URL=https://crypto-idea.web.app

# CoinGecko Demo/paid API key — can instead be set in Admin → Settings.
# Required for the "all ~3,000 coins every 5 min" price refresh at scale.
COINGECKO_DEMO_KEY=
