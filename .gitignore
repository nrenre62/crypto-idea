# ═══ Crypto Idea — .gitignore ═══

# Dependencies
node_modules/
functions/node_modules/

# Build output
dist/
.vite/

# Environment variables (NEVER commit real values; the *.example templates ARE tracked)
# API-SECURITY (2026-07-08): broadened from .env/.env.local/.env.production to catch EVERY
# .env.* variant (.env.staging/.development/.test/…) so a stray one can't be swept in by `git add -A`.
.env
.env.*
!.env.example

# Service-account / private keys / other credentials (NEVER commit — god-mode credentials)
*serviceAccount*.json
*service-account*.json
*-key.json
*_key.json
serviceAccountKey.json
*.pem
*.p12
*.p8
credentials*.json
.npmrc
google-services.json

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Persistent emulator data — DEV-ONLY baseline created by `npm run seed` and
# re-exported by `npm run start:all`. NEVER commit it: it holds throwaway dev
# accounts + local data, is machine-local, and is never part of a deploy.
emulator-data/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Local test-report artifacts (vitest JSON for the Jira test-sync command)
.tmp/
