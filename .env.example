# ═══════════════════════════════════════════
# Crypto Idea — Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git (it's in .gitignore)
# ═══════════════════════════════════════════

# Firebase (from Firebase Console → Project Settings → Web App)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=crypto-idea.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crypto-idea
VITE_FIREBASE_STORAGE_BUCKET=crypto-idea.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Stripe (from Stripe Dashboard → Developers → API keys)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_key_here
VITE_STRIPE_PRO_PRICE_ID=price_your_price_id_here

# CoinGecko API (optional — free Demo key from coingecko.com/en/api)
VITE_COINGECKO_API_KEY=your_demo_key_here

# Admin emails (comma-separated)
VITE_ADMIN_EMAILS=your-email@example.com
