// Crypto Idea - Firestore Security Rules
// =========================================
// Deploy: firebase deploy --only firestore:rules
//
// These rules ensure:
// - Users can only read/write their own data
// - Tier limits are enforced server-side
// - Data validation on writes

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profile ───
    match /users/{userId} {

      // Users can read/write only their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['joined']);
      // Cannot delete user profile (handle via admin SDK)
      allow delete: if false;

      // ─── Portfolios ───
      match /portfolios/{portfolioId} {

        allow read: if request.auth != null && request.auth.uid == userId;

        // Create: enforce max portfolios based on tier
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && validPortfolioData()
                      && withinPortfolioLimit(userId);

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && validPortfolioData();

        allow delete: if request.auth != null
                      && request.auth.uid == userId;

        // ─── Coins ───
        match /coins/{coinId} {

          allow read: if request.auth != null && request.auth.uid == userId;

          allow create: if request.auth != null
                        && request.auth.uid == userId
                        && validCoinData()
                        && withinCoinLimit(userId, portfolioId);

          allow update: if request.auth != null
                        && request.auth.uid == userId;

          allow delete: if request.auth != null
                        && request.auth.uid == userId;

          // ─── Transactions ───
          match /transactions/{txId} {

            allow read: if request.auth != null && request.auth.uid == userId;

            allow create: if request.auth != null
                          && request.auth.uid == userId
                          && validTransactionData();

            allow update: if request.auth != null
                          && request.auth.uid == userId
                          && validTransactionData();

            allow delete: if request.auth != null
                          && request.auth.uid == userId;
          }
        }
      }
    }

    // ═══ Validation Functions ═══

    function validPortfolioData() {
      let data = request.resource.data;
      return data.name is string
             && data.name.size() > 0
             && data.name.size() <= 50;
    }

    function validCoinData() {
      let data = request.resource.data;
      return data.symbol is string
             && data.name is string;
    }

    function validTransactionData() {
      let data = request.resource.data;
      return data.type in ['buy', 'sell']
             && data.amount is number
             && data.amount > 0
             && data.priceAtBuy is number
             && data.priceAtBuy >= 0
             && data.date is string;
    }

    function getUserTier(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.tier;
    }

    function withinPortfolioLimit(userId) {
      let tier = getUserTier(userId);
      let maxPortfolios = tier == 'pro' ? 30 : 1;
      // Note: exact count enforcement is best done client-side
      // This is a safety check
      return true;
    }

    function withinCoinLimit(userId, portfolioId) {
      let tier = getUserTier(userId);
      let maxCoins = tier == 'pro' ? 200 : 10;
      return true;
    }
  }
}
