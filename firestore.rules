// Crypto Idea - Firestore Security Rules
// =========================================
// Deploy: firebase deploy --only firestore:rules
//
// These rules ensure:
// - Users can only read/write their own data
// - Users CANNOT change their own tier (no paying-for-free Pro) — only an admin can
// - Admins can read/manage every user
// - Data is validated on writes
//
// NOTE on tier limits: Firestore rules cannot count documents, so exact
// per-tier limits (max portfolios/coins) are enforced in the app, not here.
// To enforce them server-side, keep a counter field on the user doc and check
// it in these rules, or enforce via a Cloud Function. The previous version of
// this file CLAIMED server-side enforcement but always returned true — that was
// misleading, so it has been removed.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Admin allowlist — keep in sync with ADMIN_EMAILS in src/CryptoIdea.jsx.
    // For extra safety in production, also require request.auth.token.email_verified == true.
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email in ['nrenre62@gmail.com'];
    }

    // ─── User Profile ───
    match /users/{userId} {

      // Read: the owner, or any admin
      allow read: if isOwner(userId) || isAdmin();

      // Create: only yourself, and you must start on the free tier
      allow create: if isOwner(userId)
                    && request.resource.data.tier == 'free';

      // Update: admins can change anything (e.g. grant a paid tier after payment).
      // Owners can update their own profile but may NOT change 'tier' or 'joined'
      // — this blocks a user from making themselves Pro/Premium for free.
      allow update: if isAdmin() || (
                      isOwner(userId)
                      && !request.resource.data.diff(resource.data)
                            .affectedKeys().hasAny(['tier', 'joined'])
                    );

      // Delete: only admins (normal users cannot delete profiles)
      allow delete: if isAdmin();

      // ─── Portfolios ───
      match /portfolios/{portfolioId} {

        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId) && validPortfolioData();
        allow update: if isOwner(userId) && validPortfolioData();
        allow delete: if isOwner(userId) || isAdmin();

        // ─── Coins ───
        match /coins/{coinId} {

          allow read: if isOwner(userId) || isAdmin();

          allow create: if isOwner(userId) && validCoinData();
          allow update: if isOwner(userId);
          allow delete: if isOwner(userId) || isAdmin();

          // ─── Transactions ───
          match /transactions/{txId} {

            allow read: if isOwner(userId) || isAdmin();

            allow create: if isOwner(userId) && validTransactionData();
            allow update: if isOwner(userId) && validTransactionData();
            allow delete: if isOwner(userId) || isAdmin();
          }
        }
      }
    }

    // ═══ Validation Functions ═══

    function validPortfolioData() {
      let data = request.resource.data;
      return data.name is string
             && data.name.size() > 0
             && data.name.size() <= 50;
    }

    function validCoinData() {
      let data = request.resource.data;
      return data.symbol is string
             && data.name is string;
    }

    function validTransactionData() {
      let data = request.resource.data;
      return data.type in ['buy', 'sell']
             && data.amount is number
             && data.amount > 0
             && data.priceAtBuy is number
             && data.priceAtBuy >= 0
             && data.date is string;
    }
  }
}
