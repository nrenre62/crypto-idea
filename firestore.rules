// Crypto Idea - Firestore Security Rules
// =========================================
// Deploy: firebase deploy --only firestore:rules
//
// What these rules enforce:
// - Users can only read/write their own data; admins can read/manage everyone
// - Admin = a verified Firebase custom claim ({ admin: true }) set via the Admin
//   SDK (functions/index.js setAdminClaim + functions/scripts/set-admin.js).
//   No email allowlist.
// - Users CANNOT change their own tier (no paying-for-free Pro) — only an admin can
// - Tier limits (max portfolios / coins / transactions) enforced via maintained
//   counters: every create must atomically increment a counter on its parent, and
//   the post-write counter must stay within the tier limit. See firebase-database.js
//   (writeBatch + increment) which keeps these counters in sync.
//
// NOTE: Premium *custom* limits (per-user premiumLimits) are checked client-side;
// these rules use the tier defaults (Premium 15 portfolios / 1,000 coins / 5,000 tx)
// and clamp EVERY configured limit to a hard ceiling — coins can never exceed 1,000
// per portfolio, so "unlimited" Premium can't be bot-inflated into a denial-of-wallet
// (decision #20). A finite default is not a license to raise the ceiling.
//
// IMPORTANT: test changes with the Firebase emulator (firebase emulators:start)
// before deploying — counter logic is easy to get subtly wrong.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Admin via verified custom claim — set server-side with the Admin SDK.
    // ISO-1 (G3): read the claim null-safely — a token WITHOUT the `admin` claim has
    // no such key, and `token.admin == true` raises a rules-eval error on it (fails
    // to deny, but brittle). `.get('admin', false)` treats "no claim" as false cleanly.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // ─── Server-only config (API keys, email settings) ───
    // No client can read or write this — only the Admin SDK (Cloud Functions:
    // saveConfig writes it; the proxy/PayPal functions read it).
    match /config/{document=**} {
      allow read, write: if false;
    }

    // ─── Server-only audit log (admin actions) ───
    // Written by Cloud Functions via the Admin SDK; no client can read or write it.
    match /audit/{document=**} {
      allow read, write: if false;
    }

    // ─── Other server-only / shared collections (ISO-1 G2) ───
    // These are already safe via Firestore's implicit default-deny (no client rule
    // matches them), but declare EXPLICIT denies so a future broad catch-all can't
    // silently open them:
    //  · rateLimits/{uid}__*  — per-uid budget/cooldown counters (functions/guards.js)
    //  · webhookEvents/{id}   — PayPal webhook idempotency ledger
    //  · cache/**             — shared PUBLIC market data (universe/trending), written
    //                           only by the proxy; no per-user data lives here.
    match /rateLimits/{document=**} {
      allow read, write: if false;
    }
    match /webhookEvents/{document=**} {
      allow read, write: if false;
    }
    match /cache/{document=**} {
      allow read, write: if false;
    }

    // ─── Tier limits ───
    function tierOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.tier;
    }
    // Admin-editable tier limits live in config/app.plans (written by saveConfig).
    // Rules read them here so the configured limit is the ENFORCED ceiling; when
    // nothing is configured we fall back to the built-in defaults. config/app is
    // unreadable by clients, but get()/exists() inside rules may still read it.
    // The configured value is the ENFORCED limit, but it can never exceed the
    // product's HARD ceiling for that key (hardMax) — config may only LOWER a limit,
    // never raise it past the ceiling. hardMax mirrors the Math.min() caps in
    // functions/index.js mergePlans (portfolios 100000, coins 1000, tx 1000000), so
    // the two enforcement layers agree on the literal 1,000-coin clamp (#20).
    function configuredLimit(userId, key, defFree, defPro, defPrem, hardMax) {
      let t = tierOf(userId);
      let fallback = t == 'premium' ? defPrem : t == 'pro' ? defPro : defFree;
      let cfgPath = /databases/$(database)/documents/config/app;
      let plan = exists(cfgPath) ? get(cfgPath).data.get('plans', {}).get(t, {}) : {};
      let planVal = plan.get(key, fallback);
      // Premium users may carry an admin-set PER-USER override (users/{uid}.premiumLimits
      // {portfolios?,coins?,transactions?}). It wins over the tier plan but is still
      // clamped to hardMax below (#20: coins can never exceed 1,000). Owners can't write
      // premiumLimits (it's in the users update blocklist), so it's server-authoritative.
      // For non-premium tiers the per-user override is ignored (no extra get()).
      let want = (t == 'premium')
        ? get(/databases/$(database)/documents/users/$(userId)).data.get('premiumLimits', {}).get(key, planVal)
        : planVal;
      return want < hardMax ? want : hardMax;
    }
    function maxPortfolios(userId) { return configuredLimit(userId, 'portfolios', 1, 3, 15, 100000); }
    function maxCoins(userId)      { return configuredLimit(userId, 'coins', 10, 50, 1000, 1000); }
    function maxTx(userId)         { return configuredLimit(userId, 'transactions', 50, 2000, 5000, 1000000); }

    // Counter changes (made by clients to keep aggregates in sync) must move by at
    // most 1 per write, so they can't be reset to smuggle past a limit in one shot.
    function counterDeltaOk(field) {
      let oldVal = resource.data.get(field, 0);
      let newVal = request.resource.data.get(field, 0);
      return newVal >= oldVal - 1 && newVal <= oldVal + 1;
    }

    // ─── User Profile ───
    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      // Create yourself, on the free tier, with a zeroed portfolio counter.
      // The profile shape is validated: name is required + bounded (validUserData),
      // and the optional consent record + preferences/settings map are shape-checked
      // when present (USER-CREATION.md §4, USER-SETTINGS.md §4).
      allow create: if isOwner(userId)
                    && request.resource.data.tier == 'free'
                    && request.resource.data.get('portfolioCount', 0) == 0
                    // ISO-1 (G1): CLOSED-SHAPE allowlist — the created doc may ONLY carry
                    // these keys. This pre-empts the "server starts trusting a field" trap:
                    // a new field (admin/isAdmin/role/anything unknown) is rejected by
                    // default, so it can never be self-granted. Subsumes the BL-1 billing
                    // blocklist below (kept for documentation of the specifically-dangerous
                    // fields — paypalSubscriptionId/tierBeforeFailure/subscription drive the
                    // recovery + period-end sweep and must never be client-seeded).
                    && request.resource.data.keys().hasOnly(['email', 'name', 'tier', 'joined', 'lastLogin', 'portfolioCount', 'settings', 'consent'])
                    && !request.resource.data.keys().hasAny(['subscription', 'billingCycle', 'tierBeforeFailure', 'paypalSubscriptionId', 'premiumLimits', 'deleted', 'deletedAt'])
                    && validUserData(request.resource.data)
                    && (!('consent'  in request.resource.data) || validConsent(request.resource.data.consent))
                    && (!('settings' in request.resource.data) || validSettings(request.resource.data.settings));

      // Admins can change anything (e.g. grant a paid tier after payment).
      // Owners may update their profile but NOT the server-authoritative fields
      // 'tier'/'joined', the soft-delete fields 'deleted'/'deletedAt', the admin-set
      // 'premiumLimits' override, or the BILLING fields the server now trusts (BL-1):
      // 'subscription' (the cancellation marker the enforceSubscriptionPeriods sweep
      // flips on — an owner clearing it would keep a paid tier without paying),
      // 'paypalSubscriptionId'/'tierBeforeFailure' (setting a victim's sub id + a fake
      // last-paid tier would get PAYMENT.SALE.COMPLETED to grant that tier), and
      // 'billingCycle' (revenue accounting). All written by Admin-SDK callables only.
      // They may only nudge portfolioCount by ±1 (kept in sync with portfolio create/
      // delete), and any name/settings/consent they DO write must keep the closed shape.
      allow update: if isAdmin() || (
                      isOwner(userId)
                      // ISO-1 (G1): CLOSED-SHAPE allowlist on the CHANGED keys — an owner
                      // may only ever touch these five fields. Anything else (the privileged
                      // billing/tier/soft-delete/premiumLimits fields AND any unknown key
                      // like admin/isAdmin/role) is rejected by default. Supersedes the old
                      // `!affectedKeys().hasAny([privileged])` blocklist, which left new
                      // fields owner-writable — the exact trap this closes.
                      && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['name', 'settings', 'consent', 'portfolioCount', 'lastLogin'])
                      && counterDeltaOk('portfolioCount')
                      && (!('name'     in request.resource.data) || validUserData(request.resource.data))
                      && (!('settings' in request.resource.data) || validSettings(request.resource.data.settings))
                      && (!('consent'  in request.resource.data) || validConsent(request.resource.data.consent))
                    );

      allow delete: if isAdmin();

      // ─── Portfolios ───
      match /portfolios/{portfolioId} {
        function userRef() {
          return /databases/$(database)/documents/users/$(userId);
        }

        allow read: if isOwner(userId) || isAdmin();

        // Create requires: valid data, zeroed coin counter, and the parent user's
        // portfolioCount incremented by exactly 1 and still within the tier limit.
        allow create: if isOwner(userId)
                      && validPortfolioData()
                      && request.resource.data.get('coinCount', 0) == 0
                      && getAfter(userRef()).data.portfolioCount == get(userRef()).data.get('portfolioCount', 0) + 1
                      && getAfter(userRef()).data.portfolioCount <= maxPortfolios(userId);

        // Update (incl. coinCount maintenance) — coinCount may move by ±1 only
        allow update: if (isOwner(userId) && validPortfolioData() && counterDeltaOk('coinCount'))
                      || isAdmin();

        allow delete: if isOwner(userId) || isAdmin();

        // ─── Coins ───
        match /coins/{coinId} {
          function portfolioRef() {
            return /databases/$(database)/documents/users/$(userId)/portfolios/$(portfolioId);
          }

          allow read: if isOwner(userId) || isAdmin();

          allow create: if isOwner(userId)
                        && validCoinData()
                        && request.resource.data.get('txCount', 0) == 0
                        && getAfter(portfolioRef()).data.coinCount == get(portfolioRef()).data.get('coinCount', 0) + 1
                        && getAfter(portfolioRef()).data.coinCount <= maxCoins(userId);

          // Validate content (incl. the optional thesis journal) on update too, and
          // keep txCount moving by at most 1 — so a coin's journal can be written/
          // reviewed but the doc can't be corrupted or used to smuggle past a limit.
          allow update: if (isOwner(userId) && validCoinData() && counterDeltaOk('txCount')) || isAdmin();

          allow delete: if isOwner(userId) || isAdmin();

          // ─── Transactions ───
          match /transactions/{txId} {
            function coinRef() {
              return /databases/$(database)/documents/users/$(userId)/portfolios/$(portfolioId)/coins/$(coinId);
            }

            allow read: if isOwner(userId) || isAdmin();

            allow create: if isOwner(userId)
                          && validTransactionData()
                          && getAfter(coinRef()).data.txCount == get(coinRef()).data.get('txCount', 0) + 1
                          && getAfter(coinRef()).data.txCount <= maxTx(userId);

            allow update: if (isOwner(userId) && validTransactionData()) || isAdmin();

            allow delete: if isOwner(userId) || isAdmin();
          }
        }
      }

      // ─── Learn progress (gamification state) ───
      // One per-user doc: users/{uid}/learn/progress. Low-stakes SELF data (it never
      // touches tier/limits/money), so the owner may write it within a bounded, typed
      // shape. validLearnProgress caps sizes so it can't be abused as free storage;
      // note Firestore rules can't validate list ELEMENTS, only the list's size.
      match /learn/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validLearnProgress(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ═══ Validation Functions ═══

    // ── User profile shape (USER-CREATION.md §4 / USER-SETTINGS.md §4–§5) ──
    // Closed, typed, size-capped so an owner can't smuggle a 1,000-char name or an
    // arbitrary settings blob. Privileged fields (tier/joined/deleted*/premiumLimits)
    // are blocked separately in the users update rule, not here.
    function validUserData(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 50;
    }

    // Mandatory acceptances captured at signup (Terms + Privacy) — a RECORD, not a
    // withdrawable toggle. Withdrawable marketing/analytics consents live in settings.
    function validConsent(c) {
      return c is map
             && c.keys().hasOnly(['termsVersion', 'termsAcceptedAt', 'privacyVersion', 'privacyAcceptedAt'])
             && c.termsVersion is string && c.termsVersion.size() <= 20
             && c.termsAcceptedAt is string && c.termsAcceptedAt.size() <= 40
             && c.privacyVersion is string && c.privacyVersion.size() <= 20
             && c.privacyAcceptedAt is string && c.privacyAcceptedAt.size() <= 40;
    }

    // Owner-writable preferences + withdrawable consents — one closed, typed map (the
    // validLearnProgress discipline). 'theme' is wired (dark mode); 'currency' is
    // validated but its display-formatting is deferred. Each key is optional but,
    // when present, must match its type/enum; hasOnly blocks any unknown key.
    // Transactional email (security/payment) has no toggle — it always sends.
    function validSettings(s) {
      return s is map
             && s.keys().hasOnly(['theme', 'currency', 'emailDigest', 'emailMarketing', 'consentAnalytics', 'planChosen', 'updatedAt'])
             && (!('theme' in s)            || s.theme in ['light', 'dark', 'system'])
             && (!('currency' in s)         || (s.currency is string && s.currency.size() <= 8))
             && (!('emailDigest' in s)      || s.emailDigest is bool)
             && (!('emailMarketing' in s)   || s.emailMarketing is bool)
             && (!('consentAnalytics' in s) || s.consentAnalytics is bool)
             // R31-2: the new user made an explicit plan choice (no system-chosen default).
             && (!('planChosen' in s)       || s.planChosen is bool)
             && (!('updatedAt' in s)        || (s.updatedAt is string && s.updatedAt.size() <= 40));
    }

    function validPortfolioData() {
      let data = request.resource.data;
      return data.name is string
             && data.name.size() > 0
             && data.name.size() <= 50
             // R32: an optional custom coin order for the Research → Coins view. Display-only,
             // owner-writable; rules can't inspect list ELEMENTS, so bound the SIZE (≤1000,
             // mirroring the coins hardMax) so it can't be abused as free storage.
             && (!('coinOrder' in data) || (data.coinOrder is list && data.coinOrder.size() <= 1000));
    }

    function validCoinData() {
      let data = request.resource.data;
      return data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 20
             && data.name is string && data.name.size() > 0 && data.name.size() <= 64
             && (!('thumb' in data) || (data.thumb is string && data.thumb.size() <= 512))
             && (!('journal' in data) || validJournal(data.journal));
    }

    // Investment-thesis journal stored on a coin (the "write before you buy" feature):
    // why you bought it, what would change your mind, and the running review status.
    function validJournal(j) {
      return j is map
             && j.keys().hasOnly(['thesis', 'changeMyMind', 'status', 'priceAtAdd', 'createdAt', 'funnel'])
             && j.thesis is string && j.thesis.size() <= 2000
             && j.changeMyMind is string && j.changeMyMind.size() <= 2000
             && j.status in ['intact', 'review', 'challenged']
             && j.priceAtAdd is number && j.priceAtAdd >= 0
             && j.createdAt is string && j.createdAt.size() <= 40
             && (!('funnel' in j) || validFunnel(j.funnel));
    }

    // Optional manual-research funnel findings (#27): dilution/unlocks, real
    // trading volume vs wash-trading, and real yield. Each is optional bounded
    // text the user records by hand; hasOnly blocks unknown keys. The whole
    // funnel object is optional on the journal (backward-compatible).
    function validFunnel(f) {
      return f is map
             && f.keys().hasOnly(['dilution', 'volume', 'yield'])
             && (!('dilution' in f) || (f.dilution is string && f.dilution.size() <= 2000))
             && (!('volume' in f) || (f.volume is string && f.volume.size() <= 2000))
             && (!('yield' in f) || (f.yield is string && f.yield.size() <= 2000));
    }

    // Learn gamification state (users/{uid}/learn/progress). Bounded + typed, with
    // exactly these keys (hasOnly blocks junk fields). Lists are size-capped — rules
    // can't inspect list elements, but this is the user's own low-stakes progress,
    // not a privilege, so a size bound is the right ceiling.
    function validLearnProgress(p) {
      return p.keys().hasOnly(['xp', 'streak', 'lastActivity', 'completedLessons', 'updatedAt'])
             && p.xp is number && p.xp >= 0 && p.xp <= 10000000
             && p.streak is number && p.streak >= 0 && p.streak <= 100000
             && p.lastActivity is string && p.lastActivity.size() <= 40
             && p.completedLessons is list && p.completedLessons.size() <= 500
             && p.updatedAt is string && p.updatedAt.size() <= 40;
    }

    function validTransactionData() {
      let data = request.resource.data;
      return data.type in ['buy', 'sell']
             && data.amount is number
             && data.amount > 0
             && data.amount <= 1000000000000000
             && data.priceAtBuy is number
             && data.priceAtBuy >= 0
             && data.priceAtBuy <= 1000000000
             && data.date is string
             && data.date.size() > 0
             && data.date.size() <= 40;
    }
  }
}
